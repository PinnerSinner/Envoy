                               "modes": ["Windowed", "Borderless", "Exclusive fullscreen"] },
    "SECURITY.md": { "headings": ["Supported versions", "Verifying a download", "For contributors"],
                     "links": ["docs/security/threat-model.md", "docs/privacy.md"] },

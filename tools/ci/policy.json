    "docs/security/threat-model.md": { "headings": ["Assets", "Trust boundaries", "Egress", "Threats", "Out of scope", "Review log"],
                                       "threats": 16 },
    "docs/releasing.md": { "headings": ["Before tagging", "Pre-release manual pass", "Tag", "After the release"],

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- olympian palette. Every brush key here must exist in every Palette.*.xaml. -->
  <Color x:Key="Bg.Window.Color">#0B1828</Color>
  <Color x:Key="Bg.Panel.Color">#122438</Color>
  <Color x:Key="Bg.PanelAlt.Color">#192E46</Color>
  <Color x:Key="Bg.Input.Color">#081321</Color>
  <Color x:Key="Accent.Color">#D2A65A</Color>
  <Color x:Key="Accent.Bright.Color">#F2CD8A</Color>
  <Color x:Key="Accent.Dim.Color">#7C6233</Color>
  <Color x:Key="Text.Primary.Color">#F2EFE8</Color>
  <Color x:Key="Text.Secondary.Color">#BAC3CF</Color>
  <Color x:Key="Text.Muted.Color">#7D8EA2</Color>
  <Color x:Key="Text.OnAccent.Color">#120C04</Color>
  <Color x:Key="Border.Subtle.Color">#243B56</Color>
  <Color x:Key="Danger.Color">#C65645</Color>
  <Color x:Key="Success.Color">#7DB07A</Color>
  <Color x:Key="Overlay.Text.Color">#F4F1EA</Color>
  <Color x:Key="Overlay.Sender.Color">#EAC27C</Color>
  <Color x:Key="Overlay.Original.Color">#93A3B6</Color>
  <Color x:Key="Overlay.Bg.Color">#081321</Color>
  <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Bg.Panel.Color}" />
  <SolidColorBrush x:Key="Bg.PanelAlt" Color="{StaticResource Bg.PanelAlt.Color}" />
  <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource Bg.Input.Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Accent.Bright" Color="{StaticResource Accent.Bright.Color}" />
  <SolidColorBrush x:Key="Accent.Dim" Color="{StaticResource Accent.Dim.Color}" />
  <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Text.Muted.Color}" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Text.OnAccent.Color}" />
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
  <SolidColorBrush x:Key="Overlay.Text" Color="{StaticResource Overlay.Text.Color}" />
  <SolidColorBrush x:Key="Overlay.Sender" Color="{StaticResource Overlay.Sender.Color}" />
  <SolidColorBrush x:Key="Overlay.Original" Color="{StaticResource Overlay.Original.Color}" />
  <LinearGradientBrush x:Key="Header.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#17304B" /><GradientStop Offset="1" Color="#0B1828" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#F2CD8A" /><GradientStop Offset="1" Color="#D2A65A" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Rule.Gradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00D2A65A" /><GradientStop Offset="0.5" Color="#D2A65A" /><GradientStop Offset="1" Color="#00D2A65A" /></LinearGradientBrush>
</ResourceDictionary>

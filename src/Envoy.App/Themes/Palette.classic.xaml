<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- classic palette. Every brush key here must exist in every Palette.*.xaml. -->
  <Color x:Key="Bg.Window.Color">#1E1710</Color>
  <Color x:Key="Bg.Panel.Color">#2A2017</Color>
  <Color x:Key="Bg.PanelAlt.Color">#33271B</Color>
  <Color x:Key="Bg.Input.Color">#16110B</Color>
  <Color x:Key="Accent.Color">#CC8A3C</Color>
  <Color x:Key="Accent.Bright.Color">#EEAE5F</Color>
  <Color x:Key="Accent.Dim.Color">#76501F</Color>
  <Color x:Key="Text.Primary.Color">#F1E3C9</Color>
  <Color x:Key="Text.Secondary.Color">#C4AF8E</Color>
  <Color x:Key="Text.Muted.Color">#8E7C62</Color>
  <Color x:Key="Text.OnAccent.Color">#170F06</Color>
  <Color x:Key="Border.Subtle.Color">#45372A</Color>
  <Color x:Key="Danger.Color">#C4553C</Color>
  <Color x:Key="Success.Color">#8DAA5C</Color>
  <Color x:Key="Overlay.Text.Color">#F4E7D0</Color>
  <Color x:Key="Overlay.Sender.Color">#EAAE5E</Color>
  <Color x:Key="Overlay.Original.Color">#A69276</Color>
  <Color x:Key="Overlay.Bg.Color">#16110B</Color>
  <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Bg.Panel.Color}" />
  <SolidColorBrush x:Key="Bg.PanelAlt" Color="{StaticResource Bg.PanelAlt.Color}" />
  <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource Bg.Input.Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Accent.Bright" Color="{StaticResource Accent.Bright.Color}" />
  <SolidColorBrush x:Key="Accent.Dim" Color="{StaticResource Accent.Dim.Color}" />
  <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Text.Muted.Color}" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Text.OnAccent.Color}" />
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
  <SolidColorBrush x:Key="Overlay.Text" Color="{StaticResource Overlay.Text.Color}" />
  <SolidColorBrush x:Key="Overlay.Sender" Color="{StaticResource Overlay.Sender.Color}" />
  <SolidColorBrush x:Key="Overlay.Original" Color="{StaticResource Overlay.Original.Color}" />
  <LinearGradientBrush x:Key="Header.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#2E2318" /><GradientStop Offset="1" Color="#1E1710" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#EEAE5F" /><GradientStop Offset="1" Color="#CC8A3C" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Rule.Gradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00CC8A3C" /><GradientStop Offset="0.5" Color="#CC8A3C" /><GradientStop Offset="1" Color="#00CC8A3C" /></LinearGradientBrush>
</ResourceDictionary>

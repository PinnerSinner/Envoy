<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- parchment palette. Every brush key here must exist in every Palette.*.xaml. -->
  <Color x:Key="Bg.Window.Color">#CDB98F</Color>
  <Color x:Key="Bg.Panel.Color">#EADCBD</Color>
  <Color x:Key="Bg.PanelAlt.Color">#E2D1AC</Color>
  <Color x:Key="Bg.Input.Color">#F6EEDB</Color>
  <Color x:Key="Accent.Color">#8E2E1C</Color>
  <Color x:Key="Accent.Bright.Color">#B0402A</Color>
  <Color x:Key="Accent.Dim.Color">#7A5A35</Color>
  <Color x:Key="Text.Primary.Color">#2A1C0F</Color>
  <Color x:Key="Text.Secondary.Color">#55412C</Color>
  <Color x:Key="Text.Muted.Color">#87704F</Color>
  <Color x:Key="Text.OnAccent.Color">#F7EEDA</Color>
  <Color x:Key="Border.Subtle.Color">#C2AA7E</Color>
  <Color x:Key="Danger.Color">#A1301F</Color>
  <Color x:Key="Success.Color">#4E7A33</Color>
  <Color x:Key="Overlay.Text.Color">#F4E9D1</Color>
  <Color x:Key="Overlay.Sender.Color">#E1B866</Color>
  <Color x:Key="Overlay.Original.Color">#B8A27F</Color>
  <Color x:Key="Overlay.Bg.Color">#2B1F14</Color>
  <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Bg.Panel.Color}" />
  <SolidColorBrush x:Key="Bg.PanelAlt" Color="{StaticResource Bg.PanelAlt.Color}" />
  <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource Bg.Input.Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Accent.Bright" Color="{StaticResource Accent.Bright.Color}" />
  <SolidColorBrush x:Key="Accent.Dim" Color="{StaticResource Accent.Dim.Color}" />
  <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Text.Muted.Color}" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Text.OnAccent.Color}" />
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
  <SolidColorBrush x:Key="Overlay.Text" Color="{StaticResource Overlay.Text.Color}" />
  <SolidColorBrush x:Key="Overlay.Sender" Color="{StaticResource Overlay.Sender.Color}" />
  <SolidColorBrush x:Key="Overlay.Original" Color="{StaticResource Overlay.Original.Color}" />
  <LinearGradientBrush x:Key="Header.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#3A2A1A" /><GradientStop Offset="1" Color="#2A1E12" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#B0402A" /><GradientStop Offset="1" Color="#8E2E1C" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Rule.Gradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#008E2E1C" /><GradientStop Offset="0.5" Color="#8E2E1C" /><GradientStop Offset="1" Color="#008E2E1C" /></LinearGradientBrush>
</ResourceDictionary>

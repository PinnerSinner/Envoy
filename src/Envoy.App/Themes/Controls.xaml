<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Envoy.App.Controls">

    <!--
        Shared control library. Colours always come from the active Palette.*.xaml via DynamicResource,
        so swapping palettes re-skins everything live. Look and feel: thin gilded rules, diamond corner studs
        and engraved serif capitals, after the Age series' in-game menus.
    -->

    <FontFamily x:Key="Font.Display">pack://application:,,,/Envoy;component/Assets/Fonts/#Cinzel</FontFamily>
    <FontFamily x:Key="Font.Decorative">pack://application:,,,/Envoy;component/Assets/Fonts/#Cinzel Decorative</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <c:NullToCollapsedConverter x:Key="NullToCollapsed" />

    <!-- ===== Typography ===== -->
    <Style x:Key="Text.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Bright}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Text.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="LineHeight" Value="19" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Muted}" />
    </Style>
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Decoration ===== -->

    <!-- A gilded rule with a centre diamond, used between sections. -->
    <Style x:Key="Flourish" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Rectangle Height="1" Fill="{DynamicResource Rule.Gradient}" VerticalAlignment="Center" />
                        <Rectangle Width="7" Height="7" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Double-ruled frame with diamond studs at the corners. -->
    <Style x:Key="OrnateFrame" TargetType="ContentControl">
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Background" Value="{DynamicResource Bg.Panel}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Accent.Dim}" BorderThickness="1" />
                        <Border Margin="3" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" />
                        <Rectangle Style="{DynamicResource Stud}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-3,-3,0,0" />
                        <Rectangle Style="{DynamicResource Stud}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" />
                        <Rectangle Style="{DynamicResource Stud}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-3,0,0,-3" />
                        <Rectangle Style="{DynamicResource Stud}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Stud" TargetType="Rectangle">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource Accent}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value><RotateTransform Angle="45" /></Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Button.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Dim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Glow" Margin="1" BorderBrush="{DynamicResource Accent}" BorderThickness="0,1,0,0" Opacity="0.35" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent.Bright}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Input}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Accent.Gradient}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Bright}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style x:Key="Button.Chrome" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <!-- A phrase "chip" in the reply box. -->
    <Style x:Key="Button.Chip" TargetType="Button" BasedOn="{StaticResource Button.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,6,6" />
    </Style>

    <!-- ===== Navigation (sidebar) ===== -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Nav" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" Height="42">
                        <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="{DynamicResource Accent}" Visibility="Hidden" />
                        <Border x:Name="Shade" Background="{DynamicResource Bg.PanelAlt}" Opacity="0" Margin="3,0,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="20,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Text.Icon}" Width="22" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shade" Property="Opacity" Value="0.6" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Shade" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent.Bright}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Theme picker card -->
    <Style x:Key="ThemeCard" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Theme" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Width" Value="200" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" BorderThickness="1" BorderBrush="{DynamicResource Border.Subtle}" Background="{DynamicResource Bg.PanelAlt}" Padding="12,10">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Dim}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style x:Key="Input.Base" TargetType="Control">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Bg.Input}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource Input.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Accent.Bright}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Dim}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- HotkeyBox derives from TextBox, so the implicit TextBox style above does not reach it on its own. -->
    <Style TargetType="c:HotkeyBox" BasedOn="{StaticResource {x:Type TextBox}}" />

    <Style TargetType="PasswordBox" BasedOn="{StaticResource Input.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Accent.Bright}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="PasswordChar" Value="•" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource Input.Base}">
        <Setter Property="Padding" Value="10,4,30,4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="MaxDropDownHeight" Value="340" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="2">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M0,0 L5,5 L10,0"
                                              Stroke="{DynamicResource Accent}" StrokeThickness="1.6" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent.Dim}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="0,2,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Background="{DynamicResource Bg.PanelAlt}"
                                    BorderBrush="{DynamicResource Accent.Dim}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg.Panel}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent.Bright}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox as a toggle switch -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0" Fill="{DynamicResource Text.Muted}" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent.Bright}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Text.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: gilt fill and a diamond thumb -->
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Blank" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Bg.Input}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Fill}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Blank}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle x:Name="Diamond" Width="11" Height="11" Fill="{DynamicResource Accent.Bright}" Stroke="{DynamicResource Bg.Window}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                                            </Rectangle>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="4" Background="{DynamicResource Accent.Dim}" Margin="1,0" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="{DynamicResource Accent.Dim}" Margin="0,1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Dim}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MaxWidth" Value="360" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="TextDecorations" Value="None" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Accent.Bright}" />
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A label + control row used throughout settings -->
    <Style x:Key="SettingRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!-- Context menu for the tray-less in-app menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Bg.PanelAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Dim}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!--
        A page callout (spec 07a, REQ-OUXA-22): Content is a Core PageHint (or null, which collapses it). A 3 px left
        edge in Accent (Info) or Danger (Warning, Error), a glyph, the sentence, and an optional button that runs the page
        view model's RunHintActionCommand with the hint's ActionId.
    -->
    <Style x:Key="Callout" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Visibility" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToCollapsed}}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border x:Name="Bd" Background="{DynamicResource Bg.PanelAlt}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Padding="14,10">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Content="{Binding ActionLabel}" CommandParameter="{Binding ActionId}"
                                    Command="{Binding DataContext.RunHintActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="{Binding ActionLabel, TargetNullValue=''}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="Glyph" Text="&#xE946;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Accent}" FontSize="16"
                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                            <TextBlock Text="{Binding Text}" Style="{StaticResource Text.Label}" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Danger}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Danger}" />
                            <Setter TargetName="Glyph" Property="Text" Value="&#xEA39;" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

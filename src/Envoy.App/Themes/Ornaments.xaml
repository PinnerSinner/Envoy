<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:c="clr-namespace:Envoy.App.Controls"
                    mc:Ignorable="po">

    <!--
        The Herald's Writ ornament kit (spec 09a, REQ-HRD-4). Palette-independent: fonts, geometry and the ornament styles.
        Geometry comes from the SVG paths in docs/design/herald/*.dc.html; every colour is a palette key (DynamicResource),
        so a palette swap re-colours every ornament. Merged by Controls.xaml (so its StaticResource lookups resolve),
        which App.xaml merges after the palette.
    -->

    <!-- ===== Type (REQ-HRD-3). Embedded OFL fonts; CJK and Cyrillic fall back to the Windows UI fonts. ===== -->
    <FontFamily x:Key="Font.Wordmark">pack://application:,,,/Envoy;component/Assets/Fonts/#UnifrakturMaguntia, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Title">pack://application:,,,/Envoy;component/Assets/Fonts/#IM FELL English SC, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Body">pack://application:,,,/Envoy;component/Assets/Fonts/#EB Garamond, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Aside">pack://application:,,,/Envoy;component/Assets/Fonts/#IM FELL English, Microsoft YaHei UI, Malgun Gothic, Yu Gothic UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Geometry ===== -->

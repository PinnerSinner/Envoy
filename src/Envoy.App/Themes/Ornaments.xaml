    <c:FirstLetterConverter x:Key="FirstLetter" />

    <!-- ===== Ornament styles ===== -->

    <!-- A corner boss: a gold lozenge with a wax pip (the charter's four corners). -->
    <Style x:Key="Boss" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Rectangle Fill="{DynamicResource Boss.Gradient}" Stroke="{DynamicResource Gules.Dark}" StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                        </Rectangle>
                        <Ellipse Width="12" Height="12" Fill="{DynamicResource Wax.Livery}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A filigree corner; the four corners mirror it with ScaleTransform. -->
    <Style x:Key="Filigree" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Width" Value="70" />
        <Setter Property="Height" Value="70" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Canvas Width="70" Height="70">
                        <Path Data="{StaticResource Geo.Filigree}" Stroke="{DynamicResource Ornament.Filigree}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Path Data="{StaticResource Geo.Filigree.Dot}" Fill="{DynamicResource Livery.Primary}" />
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        CharterFrame: the vellum charter with a knotwork border band (tiled DrawingBrush), gold edge lines, corner bosses
        and filigree corners. Padding is the inner margin for the content (the reference uses 54 x 62).
    -->
    <Style x:Key="CharterFrame" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="56,52,56,40" />
        <Setter Property="Background" Value="{DynamicResource Vellum.Gradient}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" />
                        <!-- the band: 18 px of knotwork 10 px in from the edge, ruled in gold -->
                        <Grid Margin="10" IsHitTestVisible="False">
                            <Rectangle Height="18" VerticalAlignment="Top" Fill="{DynamicResource Knot.Horizontal}" Stroke="{DynamicResource Ornament.Edge}" StrokeThickness="1" />
                            <Rectangle Height="18" VerticalAlignment="Bottom" Fill="{DynamicResource Knot.Horizontal}" Stroke="{DynamicResource Ornament.Edge}" StrokeThickness="1" />
                            <Rectangle Width="18" HorizontalAlignment="Left" Fill="{DynamicResource Knot.Vertical}" Stroke="{DynamicResource Ornament.Edge}" StrokeThickness="1" />
                            <Rectangle Width="18" HorizontalAlignment="Right" Fill="{DynamicResource Knot.Vertical}" Stroke="{DynamicResource Ornament.Edge}" StrokeThickness="1" />
                        </Grid>
                        <Control Style="{StaticResource Boss}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" />
                        <Control Style="{StaticResource Boss}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                        <Control Style="{StaticResource Boss}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                        <Control Style="{StaticResource Boss}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" />
                        <Control Style="{StaticResource Filigree}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,32,0,0" />
                        <Control Style="{StaticResource Filigree}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,32,0">
                            <Control.RenderTransform><ScaleTransform ScaleX="-1" /></Control.RenderTransform>
                        </Control>
                        <Control Style="{StaticResource Filigree}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,32">
                            <Control.RenderTransform><ScaleTransform ScaleY="-1" /></Control.RenderTransform>
                        </Control>
                        <Control Style="{StaticResource Filigree}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,32">
                            <Control.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Control.RenderTransform>
                        </Control>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A lighter frame for small windows (the toast, lookup, region bar): vellum, a gold double edge, bosses. -->
    <Style x:Key="PlateFrame" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="Background" Value="{DynamicResource Vellum.Gradient}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Or.Dark}" BorderThickness="1.5" />
                        <Border Margin="4" BorderBrush="{DynamicResource Ornament.Edge}" BorderThickness="1" IsHitTestVisible="False" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fleuron: the divider rule (double gold lines either side of the 96 x 22 fleuron). -->
    <Style x:Key="Fleuron" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="4" VerticalAlignment="Center" BorderBrush="{DynamicResource Or.Dark}" BorderThickness="0,1" Margin="0,0,8,0" />
                        <Canvas Grid.Column="1" Width="96" Height="22">
                            <Path Data="{StaticResource Geo.Fleuron}" Stroke="{DynamicResource Ornament.Rule}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{StaticResource Geo.Fleuron.Diamond}" Fill="{DynamicResource Livery.Primary}" />
                            <Path Data="{StaticResource Geo.Fleuron.Dots}" Fill="{DynamicResource Ornament.Rule}" />
                        </Canvas>
                        <Border Grid.Column="2" Height="4" VerticalAlignment="Center" BorderBrush="{DynamicResource Or.Dark}" BorderThickness="0,1" Margin="8,0,0,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- DropCap: a gold box with a blackletter letter in the livery colour. Content is the letter. -->
    <Style x:Key="DropCap" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="74" />
        <Setter Property="Height" Value="74" />
        <Setter Property="FontSize" Value="54" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource DropCap.Gradient}" BorderBrush="{DynamicResource Gules.Dark}" BorderThickness="3">
                        <Border BorderBrush="{DynamicResource Or.Light}" BorderThickness="2">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Font.Wordmark}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource Livery.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        WaxSeal: a round seal (radial wax, an inner ring, a darker drop) with a glyph. Background is the wax brush (default
        the livery's), Content the glyph.
    -->
    <Style x:Key="WaxSeal" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource Wax.Livery}" />
        <Setter Property="Foreground" Value="{DynamicResource Wax.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse Fill="{DynamicResource Oak.Deep}" Opacity="0.35" Margin="0,2,0,-2" />
                        <Ellipse Fill="{TemplateBinding Background}" />
                        <Ellipse Margin="5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Opacity="0.35" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ScrollRods: the rolled wooden end of a dispatch (top and bottom of an overlay scroll). -->
    <Style x:Key="ScrollRods" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Border Margin="-6,0" CornerRadius="5" Background="{DynamicResource Rod.Gradient}" />
                        <Ellipse Width="12" Height="12" Margin="-12,-1,0,-1" HorizontalAlignment="Left" Fill="{DynamicResource Boss.Gradient}" />
                        <Ellipse Width="12" Height="12" Margin="0,-1,-12,-1" HorizontalAlignment="Right" Fill="{DynamicResource Boss.Gradient}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The livery crest: a shield in the livery's tinctures with a gold edge. -->
    <Style x:Key="Crest" TargetType="Control">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="92" />
        <Setter Property="Height" Value="112" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Grid>
                        <Path Data="{StaticResource Geo.Shield}" Fill="{DynamicResource Oak.Deep}" Opacity="0.55" Margin="0,8,0,-8" />
                        <Path Data="{StaticResource Geo.Shield}" Fill="{DynamicResource Crest.Field}" Stroke="{DynamicResource Or.Light}" StrokeThickness="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The Candle states of a provider (static here; 09b animates the flame). -->
    <Style x:Key="Candle" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Ellipse x:Name="Glow" Width="30" Height="30" VerticalAlignment="Top" Margin="0,-2,0,0" Fill="{DynamicResource Candle.Flame}" Opacity="0.45" />
                        <Ellipse x:Name="Flame" Width="14" Height="24" VerticalAlignment="Top" Margin="0,4,0,0" Fill="{DynamicResource Candle.Flame}" />
                        <Rectangle x:Name="Smoke" Width="2" Height="18" VerticalAlignment="Top" Margin="0,8,0,0" Fill="{DynamicResource Ink.Soft}" Opacity="0" />
                        <Rectangle Width="2" Height="5" VerticalAlignment="Top" Margin="0,26,0,0" Fill="{DynamicResource Ink}" />
                        <Border Width="20" Height="40" VerticalAlignment="Bottom" CornerRadius="3" Background="{DynamicResource Candle.Wax}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="Guttering">
                            <Setter TargetName="Flame" Property="Height" Value="15" />
                            <Setter TargetName="Flame" Property="Margin" Value="0,13,0,0" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Snuffed">
                            <Setter TargetName="Flame" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Glow" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Smoke" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A settings row's label: a small drop-cap square with the first letter, then the label (REQ-HRD-7). -->
    <Style x:Key="RowLabel" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center"
                                Background="{DynamicResource DropCap.Gradient}" BorderBrush="{DynamicResource Gules.Dark}" BorderThickness="1.5">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource FirstLetter}}"
                                       FontFamily="{StaticResource Font.Wordmark}" FontSize="19" Foreground="{DynamicResource Livery.Primary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Font.Body}" FontSize="17" Foreground="{DynamicResource Text.Primary}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

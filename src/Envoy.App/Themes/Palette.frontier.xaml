<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- frontier palette. Every brush key here must exist in every Palette.*.xaml. -->
  <Color x:Key="Bg.Window.Color">#0D1C1B</Color>
  <Color x:Key="Bg.Panel.Color">#132826</Color>
  <Color x:Key="Bg.PanelAlt.Color">#1A3330</Color>
  <Color x:Key="Bg.Input.Color">#091514</Color>
  <Color x:Key="Accent.Color">#C38D42</Color>
  <Color x:Key="Accent.Bright.Color">#E6B46A</Color>
  <Color x:Key="Accent.Dim.Color">#6C4E26</Color>
  <Color x:Key="Text.Primary.Color">#F0E7D3</Color>
  <Color x:Key="Text.Secondary.Color">#B6AE99</Color>
  <Color x:Key="Text.Muted.Color">#8D9991</Color>
  <Color x:Key="Text.OnAccent.Color">#140D05</Color>
  <Color x:Key="Border.Subtle.Color">#244340</Color>
  <Color x:Key="Danger.Color">#CF8378</Color>
  <Color x:Key="Success.Color">#83A862</Color>
  <Color x:Key="Overlay.Text.Color">#F2EADA</Color>
  <Color x:Key="Overlay.Sender.Color">#E2AF63</Color>
  <Color x:Key="Overlay.Original.Color">#8EA19B</Color>
  <Color x:Key="Overlay.Bg.Color">#091514</Color>
  <Color x:Key="Focus.Ring.Color">#E6B46A</Color>
  <!-- Functional alphas (not decorative): the region selector's hit-test surface and dim. Same in every palette. -->
  <Color x:Key="Overlay.HitTest.Color">#01000000</Color>
  <Color x:Key="Overlay.Dim.Color">#99000000</Color>
  <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Bg.Panel.Color}" />
  <SolidColorBrush x:Key="Bg.PanelAlt" Color="{StaticResource Bg.PanelAlt.Color}" />
  <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource Bg.Input.Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Accent.Bright" Color="{StaticResource Accent.Bright.Color}" />
  <SolidColorBrush x:Key="Accent.Dim" Color="{StaticResource Accent.Dim.Color}" />
  <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Text.Muted.Color}" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Text.OnAccent.Color}" />
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
  <SolidColorBrush x:Key="Overlay.Text" Color="{StaticResource Overlay.Text.Color}" />
  <SolidColorBrush x:Key="Overlay.Sender" Color="{StaticResource Overlay.Sender.Color}" />
  <SolidColorBrush x:Key="Overlay.Original" Color="{StaticResource Overlay.Original.Color}" />
  <SolidColorBrush x:Key="Overlay.Bg" Color="{StaticResource Overlay.Bg.Color}" />
  <SolidColorBrush x:Key="Focus.Ring" Color="{StaticResource Focus.Ring.Color}" />
  <SolidColorBrush x:Key="Overlay.HitTest" Color="{StaticResource Overlay.HitTest.Color}" />
  <SolidColorBrush x:Key="Overlay.Dim" Color="{StaticResource Overlay.Dim.Color}" />
  <LinearGradientBrush x:Key="Header.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#183230" /><GradientStop Offset="1" Color="#0D1C1B" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="0,1"><GradientStop Offset="0" Color="#E6B46A" /><GradientStop Offset="1" Color="#C38D42" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="Rule.Gradient" StartPoint="0,0" EndPoint="1,0"><GradientStop Offset="0" Color="#00C38D42" /><GradientStop Offset="0.5" Color="#C38D42" /><GradientStop Offset="1" Color="#00C38D42" /></LinearGradientBrush>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    High-contrast palette (spec 07b, REQ-OUXB-32): every colour is a Windows system colour, read when this dictionary
    loads (ThemeManager reloads it on a contrast-theme change). Chosen by ThemeResolver, never listed in the theme
    picker. The only literals are the two functional alphas, the same in every palette. Every key here must exist in
    every Palette.*.xaml.
  -->
  <x:Static x:Key="Bg.Window.Color" Member="SystemColors.WindowColor" />
  <x:Static x:Key="Bg.Panel.Color" Member="SystemColors.WindowColor" />
  <x:Static x:Key="Bg.PanelAlt.Color" Member="SystemColors.WindowColor" />
  <x:Static x:Key="Bg.Input.Color" Member="SystemColors.WindowColor" />
  <x:Static x:Key="Accent.Color" Member="SystemColors.HighlightColor" />
  <x:Static x:Key="Accent.Bright.Color" Member="SystemColors.HighlightColor" />
  <x:Static x:Key="Accent.Dim.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Text.Primary.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Text.Secondary.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Text.Muted.Color" Member="SystemColors.GrayTextColor" />
  <x:Static x:Key="Text.OnAccent.Color" Member="SystemColors.HighlightTextColor" />
  <x:Static x:Key="Border.Subtle.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Danger.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Success.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Overlay.Text.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Overlay.Sender.Color" Member="SystemColors.WindowTextColor" />
  <x:Static x:Key="Overlay.Original.Color" Member="SystemColors.GrayTextColor" />
  <x:Static x:Key="Overlay.Bg.Color" Member="SystemColors.WindowColor" />
  <x:Static x:Key="Focus.Ring.Color" Member="SystemColors.HighlightColor" />
  <Color x:Key="Overlay.HitTest.Color">#01000000</Color>
  <Color x:Key="Overlay.Dim.Color">#99000000</Color>
  <SolidColorBrush x:Key="Bg.Window" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Bg.Panel" Color="{StaticResource Bg.Panel.Color}" />
  <SolidColorBrush x:Key="Bg.PanelAlt" Color="{StaticResource Bg.PanelAlt.Color}" />
  <SolidColorBrush x:Key="Bg.Input" Color="{StaticResource Bg.Input.Color}" />
  <SolidColorBrush x:Key="Accent" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Accent.Bright" Color="{StaticResource Accent.Bright.Color}" />
  <SolidColorBrush x:Key="Accent.Dim" Color="{StaticResource Accent.Dim.Color}" />
  <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Text.Primary.Color}" />
  <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Text.Secondary.Color}" />
  <SolidColorBrush x:Key="Text.Muted" Color="{StaticResource Text.Muted.Color}" />
  <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Text.OnAccent.Color}" />
  <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Border.Subtle.Color}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource Danger.Color}" />
  <SolidColorBrush x:Key="Success" Color="{StaticResource Success.Color}" />
  <SolidColorBrush x:Key="Overlay.Text" Color="{StaticResource Overlay.Text.Color}" />
  <SolidColorBrush x:Key="Overlay.Sender" Color="{StaticResource Overlay.Sender.Color}" />
  <SolidColorBrush x:Key="Overlay.Original" Color="{StaticResource Overlay.Original.Color}" />
  <SolidColorBrush x:Key="Overlay.Bg" Color="{StaticResource Overlay.Bg.Color}" />
  <SolidColorBrush x:Key="Focus.Ring" Color="{StaticResource Focus.Ring.Color}" />
  <SolidColorBrush x:Key="Overlay.HitTest" Color="{StaticResource Overlay.HitTest.Color}" />
  <SolidColorBrush x:Key="Overlay.Dim" Color="{StaticResource Overlay.Dim.Color}" />
  <SolidColorBrush x:Key="Header.Gradient" Color="{StaticResource Bg.Window.Color}" />
  <SolidColorBrush x:Key="Accent.Gradient" Color="{StaticResource Accent.Color}" />
  <SolidColorBrush x:Key="Rule.Gradient" Color="{StaticResource Text.Muted.Color}" />
</ResourceDictionary>

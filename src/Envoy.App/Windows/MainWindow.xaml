<Window x:Class="Envoy.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Envoy.App.Controls"
        Title="Envoy" Width="1060" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Body}" Icon="pack://application:,,,/Envoy;component/Assets/envoy.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Accent.Dim}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Title bar ===== -->
            <Border Grid.ColumnSpan="2" Background="{DynamicResource Header.Gradient}" BorderBrush="{DynamicResource Accent.Dim}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Button.Chrome}" Content="&#xE921;" Click="OnMinimize" ToolTip="Minimise" />
                        <Button Style="{StaticResource Button.Chrome}" Content="&#xE922;" Click="OnMaximize" ToolTip="Maximise" />
                        <Button Style="{StaticResource Button.Chrome}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close to tray (Envoy keeps running)" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Envoy;component/Assets/envoy.png" Width="26" Height="26" />
                        <TextBlock Text="ENVOY" FontFamily="{StaticResource Font.Decorative}" FontSize="19" FontWeight="Bold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Accent.Bright}" VerticalAlignment="Center" />
                        <TextBlock Text="chat translator for the Age series" Style="{StaticResource Text.Caption}" Margin="12,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Sidebar ===== -->
            <Border Grid.Row="1" Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Live status at the bottom of the sidebar -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,10,14,16">
                        <Control Style="{StaticResource Flourish}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Host.GameStatus}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding Host.CaptureStatus}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Accent}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Opacity="0.7" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0" x:Name="Nav">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="War Room" IsChecked="True" />
                        <RadioButton x:Name="NavTranslation" Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Translation" />
                        <RadioButton x:Name="NavCapture" Style="{StaticResource NavItem}" Tag="&#xE722;" Content="Reading Chat" />
                        <RadioButton x:Name="NavOverlay" Style="{StaticResource NavItem}" Tag="&#xE81E;" Content="Overlay" />
                        <RadioButton x:Name="NavReply" Style="{StaticResource NavItem}" Tag="&#xE724;" Content="Replying" />
                        <RadioButton x:Name="NavPhrases" Style="{StaticResource NavItem}" Tag="&#xE82D;" Content="Phrasebook" />
                        <RadioButton x:Name="NavHotkeys" Style="{StaticResource NavItem}" Tag="&#xE765;" Content="Hotkeys" />
                        <RadioButton x:Name="NavAppearance" Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Appearance" />
                        <RadioButton x:Name="NavAbout" Style="{StaticResource NavItem}" Tag="&#xE946;" Content="About" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Pages ===== -->
            <Grid Grid.Row="1" Grid.Column="1">

                <!-- ============ WAR ROOM (dashboard) ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavDashboard, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="War Room" Style="{StaticResource Text.H1}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                            Envoy reads the game's chat from your screen, translates it, and shows it in an overlay. Press
                            <Run Text="{Binding Settings.Hotkeys.Compose, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Accent}" />
                            in game to reply in your opponent's language.
                        </TextBlock>

                        <Border Visibility="{Binding Host.HasUpdate, Converter={StaticResource BoolToVisibility}}" Background="{DynamicResource Accent.Gradient}"
                                Padding="16,10" Margin="0,0,0,16">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Download" Click="OnDownloadUpdate" />
                                <TextBlock Text="{Binding Host.UpdateText}" Foreground="{DynamicResource Text.OnAccent}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="-6,0,-6,8">
                            <ContentControl Style="{StaticResource OrnateFrame}" Margin="6,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="BATTLEFIELD" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Host.GameStatus}" Style="{StaticResource Text.Label}" FontSize="15" Margin="0,6,0,0" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OrnateFrame}" Margin="6,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="SCOUTS" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Host.CaptureStatus}" Style="{StaticResource Text.Label}" FontSize="15" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding OcrSummary}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OrnateFrame}" Margin="6,0,6,12">
                                <StackPanel>
                                    <TextBlock Text="INTERPRETER" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding PrimaryInfo.Name}" Style="{StaticResource Text.Label}" FontSize="15" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </ContentControl>
                        </UniformGrid>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Get ready" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="1 · Mark where chat appears" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding RegionText}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Select chat area" Style="{StaticResource Button.Primary}" Click="OnSelectRegion" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="2 · Choose your language" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="Incoming chat is translated into this; your replies are written in it." Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Code" SelectedValue="{Binding Settings.MyLanguage}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="3 · Your in-game name (optional)" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="So your own messages aren't translated back to you." Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Width="260" Text="{Binding Settings.MyPlayerName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="4 · Play in windowed or borderless mode" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                                        <TextBlock Text="Exclusive fullscreen hides overlays and captures as black. Borderless looks identical." Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Pause / resume reading" Click="OnToggleCapture" Margin="0,0,8,8" />
                                    <Button Content="Show sample messages" Click="OnDemo" Margin="0,0,8,8" />
                                    <Button Content="Move the overlay" Click="OnEditOverlay" Margin="0,0,8,8" />
                                    <Button Content="Open reply box" Click="OnCompose" Margin="0,0,8,8" />
                                    <Button Content="Scan &amp; translate…" Click="OnScan" Margin="0,0,8,8" ToolTip="Translate any text on screen (Ctrl+Shift+Q)" />
                                </WrapPanel>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="New match" Click="OnNewMatch" ToolTip="Forget this match's players and messages (happens automatically when a game starts)" />
                                    <TextBlock Text="Players this match" Style="{StaticResource Text.H2}" />
                                </DockPanel>
                                <TextBlock Text="Envoy remembers who writes in which language, so replies go out in the right one." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Host.Players}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Bg.PanelAlt}" BorderBrush="{DynamicResource Accent.Dim}" BorderThickness="1" Padding="10,5" Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Accent.Bright}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Language, StringFormat=' · {0}', TargetNullValue=' · ?'}" Style="{StaticResource Text.Caption}" Margin="4,0,0,0" />
                                                    <TextBlock Text="{Binding MessageCount, StringFormat=' · {0} msgs'}" Style="{StaticResource Text.Caption}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Dispatches" Style="{StaticResource Text.H2}" />
                                <TextBlock Text="Messages Envoy has read this session, newest first." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Host.History}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Label}">
                                                        <Run Text="{Binding SourceLanguage, Mode=OneWay, StringFormat='[{0}] '}" Foreground="{DynamicResource Text.Muted}" />
                                                        <Run Text="{Binding Chat.Sender, Mode=OneWay}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                                                        <Run Text="  " />
                                                        <Run Text="{Binding DisplayText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Chat.Text}" Style="{StaticResource Text.Caption}" FontStyle="Italic" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ TRANSLATION ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavTranslation, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Translation" Style="{StaticResource Text.H1}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                            The free providers need no account. Paid ones use <Bold>your own</Bold> key and are billed to you directly —
                            Envoy has no server of its own, so nobody else can ever spend your credits.
                        </TextBlock>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Providers" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Main provider" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PrimaryProvider}" />
                                </Grid>
                                <TextBlock Text="{Binding PrimaryInfo.Blurb}" Style="{StaticResource Text.Caption}" Margin="220,0,0,8" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="If it fails, try" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FallbackOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FallbackProvider}" />
                                </Grid>
                                <TextBlock Text="{Binding Host.ProviderStatus}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Accent}" Margin="220,4,0,0" />
                            </StackPanel>
                        </ContentControl>

                        <!-- Credentials: only the ones in use are shown -->
                        <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsDeepL, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="DeepL" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="API key" Style="{StaticResource Text.Label}" />
                                    <PasswordBox Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.DeepLKey}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,0">
                                    Free plan: 500,000 characters a month. <Hyperlink NavigateUri="https://www.deepl.com/pro-api" RequestNavigate="OnLink">Get a key</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsClaude, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Claude" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Anthropic API key" Style="{StaticResource Text.Label}" />
                                    <PasswordBox Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.ClaudeKey}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Model" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ClaudeModels}" IsEditable="False" SelectedItem="{Binding Settings.Translation.ClaudeModel}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,0" TextWrapping="Wrap">
                                    Haiku costs a fraction of a cent per message and is plenty for chat; Opus is the most capable.
                                    <Hyperlink NavigateUri="https://console.anthropic.com/" RequestNavigate="OnLink">Get a key</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsAws, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Amazon Translate" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Access key ID" Style="{StaticResource Text.Label}" />
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Translation.AwsAccessKeyId, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Secret access key" Style="{StaticResource Text.Label}" />
                                    <PasswordBox Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.AwsSecretAccessKey}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Region" Style="{StaticResource Text.Label}" />
                                    <TextBox Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding Settings.Translation.AwsRegion, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,0" TextWrapping="Wrap">
                                    Use an IAM user that can only call translate:TranslateText, and set a billing alarm in AWS for peace of mind.
                                </TextBlock>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsLibre, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="LibreTranslate" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Server URL" Style="{StaticResource Text.Label}" />
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Translation.LibreTranslateUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="API key (if required)" Style="{StaticResource Text.Label}" />
                                    <PasswordBox Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.LibreTranslateKey}" />
                                </Grid>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Behaviour" Style="{StaticResource Text.H2}" />
                                <CheckBox Content="Don't translate messages already in my language" IsChecked="{Binding Settings.Translation.SkipMyLanguage}" />
                                <CheckBox Content="Explain gamer slang (666, ㅈㅈ, изи, kkkk…) instantly and offline" IsChecked="{Binding Settings.Translation.UseSlangGlossary}" />
                                <Grid Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Daily cap for paid providers" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="500000" SmallChange="5000" LargeChange="25000" TickFrequency="5000" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.Translation.DailyCharacterLimit}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Translation.DailyCharacterLimit, StringFormat='{}{0:N0} chars'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Text="A busy match is roughly 2,000–5,000 characters. When the cap is reached Envoy switches to the free provider until tomorrow. 0 = no cap." Margin="220,0,0,0" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Filters" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Translate" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ChannelOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Channels}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Muted players" Style="{StaticResource Text.Label}" />
                                    <TextBox Grid.Column="1" Text="{Binding MutedPlayersText, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <TextBlock Text="Comma-separated names. Their messages are hidden and never sent for translation." Style="{StaticResource Text.Caption}" Margin="220,0,0,0" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Try it" Style="{StaticResource Text.H2}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Translate" Click="OnTestTranslate" Margin="8,0,0,0" />
                                    <TextBox x:Name="TestInput" Text="你好！再来一局吗？" />
                                </DockPanel>
                                <TextBlock x:Name="TestOutput" Style="{StaticResource Text.Label}" Margin="0,10,0,0" FontSize="15" />
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ READING CHAT (capture) ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavCapture, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Reading Chat" Style="{StaticResource Text.H1}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                            Envoy looks at the chat area of your screen with the text recognition built into Windows. Nothing touches the game itself.
                        </TextBlock>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Chat area" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Region" Style="{StaticResource Text.Label}" />
                                    <TextBlock Grid.Column="1" Text="{Binding RegionText}" Style="{StaticResource Text.Label}" />
                                    <Button Grid.Column="2" Content="Select chat area" Click="OnSelectRegion" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Game" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Game}" />
                                </Grid>
                                <TextBlock Text="Each game remembers its own chat area, so switching between AoE II and AoE IV just works." Style="{StaticResource Text.Caption}" Margin="220,0,0,0" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Languages to recognise" Style="{StaticResource Text.H2}" />
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10">
                                    Windows needs the OCR pack for each script. Tick the ones your opponents use; your own language is always on.
                                    Latin-script languages (Spanish, German, French…) are read by any Latin pack such as English.
                                    Missing ones can be installed from Windows Settings → Time &amp; language → Language &amp; region, or with the Install button (asks for admin).
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding OcrLanguages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,16,2">
                                                <Button DockPanel.Dock="Right" Content="Install" Padding="10,2" FontSize="11" Click="OnInstallOcr" Tag="{Binding Code}"
                                                        Visibility="{Binding Installed, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanToggle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Text.Muted}" FontSize="11" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Fine tuning" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Check for new messages every" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="250" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.IntervalMs}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.IntervalMs, StringFormat='{}{0} ms'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Enlarge before reading" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.Upscale}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.Upscale, StringFormat='{}{0:0.##}×'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Contrast" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.Contrast}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.Contrast, StringFormat='{}{0:0.0}'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <CheckBox Content="Greyscale" IsChecked="{Binding Settings.Capture.Grayscale}" />
                                <CheckBox Content="Invert colours (try this if light-on-dark text reads poorly)" IsChecked="{Binding Settings.Capture.Invert}" />
                                <CheckBox Content="Start reading chat when Envoy starts" IsChecked="{Binding Settings.StartCapturingAutomatically}" />
                                <CheckBox Content="Only read chat while an Age game is running (saves CPU)" IsChecked="{Binding Settings.Capture.OnlyWhileGameRuns}" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="PreviewStats" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="Live view" Style="{StaticResource Text.H2}" />
                                </DockPanel>
                                <TextBlock Text="What Envoy sees (after enhancement) and what it read. Open a game with chat on screen to tune the settings above." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" Background="{DynamicResource Bg.Input}" MinHeight="80">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" MaxHeight="240" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBox x:Name="PreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Margin="0,8,0,0" VerticalContentAlignment="Top" />
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ OVERLAY ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavOverlay, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Overlay" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="The translated chat floating over your game. It ignores the mouse, so it never gets in the way of play." Style="{StaticResource Text.Body}" Margin="0,0,0,18" />

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Placement" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Position" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Anchors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Overlay.Anchor}" />
                                    <Button Grid.Column="2" Content="Drag to place" Click="OnEditOverlay" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Width" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="240" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.Width}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.Width, StringFormat='{}{0:0} px'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <CheckBox Content="Show the overlay" IsChecked="{Binding Settings.Overlay.Visible}" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Look" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Text size" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="10" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.FontSize}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.FontSize, StringFormat='{}{0:0} pt'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Background" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.BackgroundOpacity}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.BackgroundOpacity, StringFormat='{}{0:P0}'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Overall opacity" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.Opacity}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.Opacity, StringFormat='{}{0:P0}'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Font (blank = theme default)" Style="{StaticResource Text.Label}" />
                                    <TextBox Grid.Column="1" Text="{Binding Settings.Overlay.FontFamily, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <CheckBox Content="Show the original text under the translation" IsChecked="{Binding Settings.Overlay.ShowOriginal}" />
                                <CheckBox Content="Show player names and channel" IsChecked="{Binding Settings.Overlay.ShowSender}" />
                                <CheckBox Content="Show which provider translated each line" IsChecked="{Binding Settings.Overlay.ShowProvider}" />
                                <CheckBox Content="Play a sound for new foreign messages" IsChecked="{Binding Settings.Overlay.PlaySound}" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Timing" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keep each message for" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="5" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.MessageLifetimeSeconds}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.MessageLifetimeSeconds, StringFormat='{}{0} s'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Most messages shown" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.MaxMessages}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.MaxMessages}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Button Content="Show sample messages" Click="OnDemo" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Herald (read aloud)" Style="{StaticResource Text.H2}" />
                                <TextBlock Text="Hear translations with a Windows voice, so your eyes stay on the battle. Offline and free." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                                <CheckBox Content="Read translated messages aloud" IsChecked="{Binding Settings.Overlay.SpeakMessages}" />
                                <CheckBox Content="Say who sent each message" IsChecked="{Binding Settings.Overlay.SpeakSenderName}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Voice" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Voices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Overlay.SpeechVoiceId}" />
                                    <Button Grid.Column="2" Content="Test" Click="OnTestVoice" Margin="8,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Volume" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.SpeechVolume}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.SpeechVolume, StringFormat='{}{0:P0}'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Speed" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Settings.Overlay.SpeechRate}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Overlay.SpeechRate, StringFormat='{}{0:0.0}×'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ REPLYING ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavReply, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Replying" Style="{StaticResource Text.H1}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                            Press <Run Text="{Binding Settings.Hotkeys.Compose, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource Accent}" /> in game,
                            type in your language, and Envoy types the translation into the game's chat for you — the same way an on-screen keyboard would.
                        </TextBlock>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Sending" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Reply in" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ReplyLanguages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Compose.DefaultTarget}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="When I press Enter" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SendModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Compose.SendMode}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Typing method" Style="{StaticResource Text.Label}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TypingMethods}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Compose.TypingMethod}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,6" TextWrapping="Wrap"
                                           Text="If characters come out wrong or missing in a particular game, switch to Paste." />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Key that opens chat in game" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding Settings.Compose.OpenChatKey}" />
                                </Grid>
                                <CheckBox Content="Add my original text in brackets after the translation" IsChecked="{Binding Settings.Compose.AppendOriginal}" />
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <TextBlock Text="Timing" Style="{StaticResource Text.H2}" />
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Wait for game to focus" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Settings.Compose.FocusDelayMs}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Compose.FocusDelayMs, StringFormat='{}{0} ms'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Delay between characters" Style="{StaticResource Text.Label}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Settings.Compose.KeystrokeDelayMs}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Compose.KeystrokeDelayMs, StringFormat='{}{0} ms'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ PHRASEBOOK ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavPhrases, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Phrasebook" Style="{StaticResource Text.H1}" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                            Hand-translated phrases for common moments. They appear as one-click chips in the reply box and are used instead of machine translation whenever you type one exactly.
                        </TextBlock>
                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Edit my phrases" Click="OnEditPhrases" />
                                    <TextBlock Text="Preview in" Style="{StaticResource Text.Label}" Margin="0,0,10,0" />
                                    <ComboBox x:Name="PhrasePreviewLanguage" Width="240" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectionChanged="OnPhrasePreviewChanged" />
                                </DockPanel>
                                <ItemsControl x:Name="PhraseList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Text.Label}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource Text.Caption}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Mine}" Style="{StaticResource Text.Label}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Theirs}" Style="{StaticResource Text.Label}" Foreground="{DynamicResource Accent.Bright}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ HOTKEYS ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavHotkeys, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Hotkeys" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="These work while the game is focused. Click a box and press a new combination; Backspace clears it." Style="{StaticResource Text.Body}" Margin="0,0,0,18" />
                        <ContentControl Style="{StaticResource OrnateFrame}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Open the reply box" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Text="{Binding Settings.Hotkeys.Compose}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Show / hide the overlay" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Text="{Binding Settings.Hotkeys.ToggleOverlay}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Pause / resume reading chat" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Text="{Binding Settings.Hotkeys.ToggleCapture}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Select the chat area" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Text="{Binding Settings.Hotkeys.SelectRegion}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Scan &amp; translate any part of the screen" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Text="{Binding Settings.Hotkeys.ScanAndTranslate}" />
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Move the overlay" Style="{StaticResource Text.Label}" />
                                    <c:HotkeyBox Grid.Column="1" Text="{Binding Settings.Hotkeys.OverlayEditMode}" />
                                </Grid>
                                <TextBlock Text="{Binding HotkeyErrors}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Danger}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ APPEARANCE ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavAppearance, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="Appearance" Style="{StaticResource Text.H1}" />
                        <TextBlock Text="Each theme takes its cue from one of the games. Settings, the overlay and the reply box all follow it." Style="{StaticResource Text.Body}" Margin="0,0,0,18" />
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource ThemeCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="250">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="40" Height="26" Fill="{Binding}" Margin="0,0,4,0" Stroke="#40000000" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent.Bright}" />
                                            <TextBlock Text="{Binding Inspiration}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ContentControl Style="{StaticResource OrnateFrame}" Margin="0,10,0,14">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource Text.H2}" />
                                <CheckBox Content="Start Envoy when I sign in to Windows" IsChecked="{Binding Settings.StartWithWindows}" />
                                <CheckBox Content="Tell me when a new version is released" IsChecked="{Binding Settings.CheckForUpdates}" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="Open logs" Click="OnOpenLogs" Padding="10,3" />
                                    <CheckBox Content="Save chat transcripts on this PC (one file per match)" IsChecked="{Binding Settings.SaveTranscripts}" />
                                </DockPanel>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ ABOUT ============ -->
                <ScrollViewer Visibility="{Binding IsChecked, ElementName=NavAbout, Converter={StaticResource BoolToVisibility}}" Padding="32,24">
                    <StackPanel MaxWidth="760">
                        <Image Source="pack://application:,,,/Envoy;component/Assets/envoy.png" Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="Envoy" Style="{StaticResource Text.H1}" FontFamily="{StaticResource Font.Decorative}" FontSize="30" />
                        <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Style="{StaticResource Text.Caption}" Margin="0,0,0,14" />
                        <Control Style="{StaticResource Flourish}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                            Envoy is an unofficial fan tool. It is not affiliated with or endorsed by Microsoft, Xbox Game Studios, World's Edge,
                            Relic Entertainment or Forgotten Empires. Age of Empires and Age of Mythology are trademarks of Microsoft.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                            <Bold>How it stays safe:</Bold> Envoy never reads or writes game memory, injects code, or modifies game files. It reads
                            pixels from your screen (like streaming software) and sends keystrokes (like an on-screen keyboard). Chat text is sent only
                            to the translation provider you choose.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12">
                            Settings and API keys live in <Run Text="{Binding DataFolder, Mode=OneWay}" />. Keys are encrypted with Windows DPAPI and
                            can only be read by your Windows account.
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                            Cinzel and Cinzel Decorative fonts © The Cinzel Project Authors, SIL Open Font License 1.1.
                        </TextBlock>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Open settings folder" Click="OnOpenData" Margin="0,0,8,0" />
                            <Button Content="Quit Envoy" Click="OnQuit" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>

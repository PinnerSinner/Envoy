<Window x:Class="Envoy.App.Windows.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        KeyboardNavigation.TabNavigation="Cycle"
        Title="Envoy: reply"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="720"
        FontFamily="{StaticResource Font.Body}">
    <!-- The scribe's desk (spec 09a, REQ-HRD-9; docs/design/herald/Main.dc.html): an oak frame around a vellum charter. -->
    <Grid Margin="12">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6" Color="Black" />
        </Grid.Effect>
        <Border Background="{DynamicResource Damask.Oak}" BorderBrush="{DynamicResource Or.Dark}" BorderThickness="1" CornerRadius="6" Padding="16">
            <ContentControl Style="{StaticResource CharterFrame}" Padding="46,40,46,30">
                <StackPanel>
                    <!-- Heading: drop cap R, "eply to {name}", the close button; drag anywhere on it -->
                    <DockPanel Margin="0,0,0,12" MouseLeftButtonDown="OnDrag" Background="Transparent">
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                Content="&#xE8BB;" ToolTip="Close (Esc)" Click="OnClose" Width="40" Height="36" Padding="0" VerticalAlignment="Top"
                                AutomationProperties.Name="Close" TabIndex="5" />
                        <ContentControl x:Name="HeadingCap" DockPanel.Dock="Left" Style="{StaticResource DropCap}" Width="56" Height="56" FontSize="40" Content="R"
                                        VerticalAlignment="Top" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeadingRest" Text="eply" FontFamily="{StaticResource Font.Title}" FontSize="30" Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Envoy types it into game chat in their language" Style="{StaticResource Text.Aside}" FontSize="14" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Language ribbon: a Label, so Alt+I reaches the language list -->
                    <DockPanel Margin="0,0,0,12">
                        <Label x:Name="ReplyInLabel" Content="Reply _in" Target="{Binding ElementName=TargetLanguage}" Padding="0" Margin="0,0,12,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Title}" FontSize="16" Foreground="{DynamicResource Accent}" />
                        <ComboBox x:Name="TargetLanguage" AutomationProperties.Name="Reply in" TabIndex="4" Width="280" HorizontalAlignment="Left" DisplayMemberPath="DisplayName" SelectionChanged="OnTargetChanged" />
                    </DockPanel>

                    <!-- The last thing they said, for context: a small dispatch -->
                    <Border x:Name="ContextBox" Background="{DynamicResource Bg.PanelAlt}" Padding="12,8" Margin="0,0,0,14" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1,1,1,3">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Label}" FontSize="16">
                            <Run x:Name="ContextSender" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource Font.Title}" />
                            <Run x:Name="ContextOriginal" FontFamily="{StaticResource Font.Aside}" FontStyle="Italic" Foreground="{DynamicResource Text.Secondary}" />
                            <Run x:Name="ContextTranslation" />
                        </TextBlock>
                    </Border>

                    <!-- Your words -->
                    <TextBlock Text="Your words" Style="{StaticResource Text.Rubric}" Margin="0,0,0,4" />
                    <Grid>
                        <TextBox x:Name="Input" AutomationProperties.Name="Your message" TabIndex="0" FontSize="20" MinHeight="44" Padding="10,8" TextChanged="OnInputChanged" PreviewKeyDown="OnInputKey" />
                        <TextBlock x:Name="Placeholder" Text="Type your message…" IsHitTestVisible="False" Margin="13,0,0,0" FontSize="20"
                                   FontFamily="{StaticResource Font.Aside}" FontStyle="Italic" VerticalAlignment="Center" Foreground="{DynamicResource Text.Muted}" />
                    </Grid>

                    <!-- The scribe writes: what will be sent, and what it means -->
                    <Border Margin="0,14,0,0" Padding="14,10" Background="{DynamicResource Bg.PanelAlt}" BorderBrush="{DynamicResource Or.Dark}" BorderThickness="1" MinHeight="64">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" x:Name="PreviewSource" Style="{StaticResource Text.Caption}" FontSize="13" VerticalAlignment="Top" />
                                <TextBlock Text="The scribe writes" Style="{StaticResource Text.Rubric}" Margin="0,0,0,4" />
                            </DockPanel>
                            <TextBlock x:Name="Preview" FontSize="20" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}" />
                            <TextBlock x:Name="BackTranslation" Style="{StaticResource Text.Aside}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Phrase ribbons -->
                    <TextBlock Text="Quick phrases" Style="{StaticResource Text.Rubric}" Margin="0,14,0,6" />
                    <ItemsControl x:Name="Phrases" Focusable="False" KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.TabIndex="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Chip}" Click="OnPhrase" Tag="{Binding}" ToolTip="{Binding Preview}"
                                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="{Binding Preview}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Control Style="{StaticResource Fleuron}" Margin="0,8,0,8" />

                    <!-- Footer: the counter and the hint, Copy, and the wax "Seal and send" -->
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CopyButton" Content="Copy" Click="OnCopy" TabIndex="2" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Copy the translation (Ctrl+Enter)" />
                            <Button x:Name="SendButton" Content="Seal and send" TabIndex="3" Style="{StaticResource Button.Primary}" Click="OnSend" ToolTip="Send to game (Enter)"
                                    AutomationProperties.Name="Seal and send" AutomationProperties.HelpText="Send to game (Enter)" />
                        </StackPanel>
                        <!-- REQ-OUXC-41: the length of what will be sent; Danger above the user's limit. -->
                        <TextBlock x:Name="CharCount" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Visibility="Collapsed" AutomationProperties.Name="Message length" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="Hint" Style="{StaticResource Text.Aside}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                    </DockPanel>
                </StackPanel>
            </ContentControl>
        </Border>
    </Grid>
</Window>

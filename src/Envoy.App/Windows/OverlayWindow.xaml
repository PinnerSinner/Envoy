<Window x:Class="Envoy.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Envoy.App.Services"
        Title="Envoy overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="Height"
        Width="560" MinHeight="10">
    <Window.Resources>
        <!-- REQ-OUXC-45: the per-message Copy button, shown only in edit mode (the overlay is click-through otherwise). -->
        <DataTemplate x:Key="CopyControls">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="6,0,0,0"
                        Visibility="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="CopyFeedback" Text="{Binding CopyFeedback}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource Overlay.Original}" />
                <Button x:Name="CopyButton" Style="{StaticResource Button.Ghost}" FontFamily="{StaticResource Font.Icons}" Content="&#xE8C8;" Padding="4,1" FontSize="12"
                        Foreground="{DynamicResource Overlay.Text}" Command="{Binding CopyCommand}" ToolTip="Copy this message"
                        AutomationProperties.Name="{Binding Sender, StringFormat='Copy message from {0}'}" />
            </StackPanel>
        </DataTemplate>

        <!-- The seal's wax by language (Core LanguageSeal.For): one trigger per SealWax value. -->
        <Style x:Key="DispatchSeal" TargetType="ContentControl" BasedOn="{StaticResource WaxSeal}">
            <Setter Property="Background" Value="{DynamicResource Wax.Purpure}" />
            <Setter Property="ToolTip" Value="{Binding LanguageName}" />
            <Setter Property="Content" Value="{Binding SealGlyph}" />
            <Setter Property="Visibility" Value="{Binding HasLanguage, Converter={StaticResource BoolToVisibility}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SealWax}" Value="Gules"><Setter Property="Background" Value="{DynamicResource Wax.Gules}" /></DataTrigger>
                <DataTrigger Binding="{Binding SealWax}" Value="Azure"><Setter Property="Background" Value="{DynamicResource Wax.Azure}" /></DataTrigger>
                <DataTrigger Binding="{Binding SealWax}" Value="Vert"><Setter Property="Background" Value="{DynamicResource Wax.Vert}" /></DataTrigger>
                <DataTrigger Binding="{Binding SealWax}" Value="Or"><Setter Property="Background" Value="{DynamicResource Wax.Or}" /></DataTrigger>
                <DataTrigger Binding="{Binding SealWax}" Value="Sable"><Setter Property="Background" Value="{DynamicResource Wax.Sable}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The full layout (spec 09a, REQ-HRD-8): a dispatch scroll. Rods top and bottom, vellum (the card background, whose
            alpha keeps the text readable, 07b), a wax seal with the language glyph, the sender as a rubric, the translation,
            and the original in italic. Spec 09b (REQ-MOT-5): the scroll unfurls from its top rod, the seal stamps in 0.3 s later
            (Core Motion.SealDelay), and at the end of its linger time it fades out like ink (Opacity, from the window's tick).
        -->
        <DataTemplate x:Key="FullItem">
            <StackPanel x:Name="Card" Margin="8,0,8,10" Opacity="{Binding Opacity}" s:Motion.Entrance="Unfurl">
                <Control Style="{StaticResource ScrollRods}" Height="8" />
                <Border Background="{Binding DataContext.CardBackground, RelativeSource={RelativeSource AncestorType=Window}}" Padding="12,9,14,10">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource CopyControls}" Content="{Binding}" />
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource DispatchSeal}" Width="38" Height="38" Margin="0,0,12,0" VerticalAlignment="Top"
                                        s:Motion.Entrance="Stamp" s:Motion.Delay="0:0:0.3" />
                        <StackPanel>
                            <TextBlock x:Name="Line" TextWrapping="Wrap" FontSize="{Binding DataContext.OverlayFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontFamily="{Binding DataContext.OverlayFontFamily, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Run Text="{Binding SenderPrefix, Mode=OneWay}" Foreground="{DynamicResource Overlay.Sender}" FontFamily="{StaticResource Font.Title}" />
                                <Run Text="{Binding Channel, Mode=OneWay}" Foreground="{DynamicResource Overlay.Original}" FontFamily="{StaticResource Font.Aside}" FontStyle="Italic" />
                                <LineBreak />
                                <Run Text="{Binding Main, Mode=OneWay}" Foreground="{DynamicResource Overlay.Text}" />
                            </TextBlock>
                            <TextBlock x:Name="OriginalLine" Text="{Binding Original}" Margin="0,2,0,0" TextWrapping="Wrap" FontStyle="Italic" FontFamily="{StaticResource Font.Aside}"
                                       FontSize="{Binding DataContext.SmallFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Foreground="{DynamicResource Overlay.Original}"
                                       Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="PendingLine" Text="translating…" Margin="0,2,0,0" FontSize="12" FontStyle="Italic" FontFamily="{StaticResource Font.Aside}" Foreground="{DynamicResource Overlay.Original}"
                                       Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="ErrorLine" Text="{Binding Error, StringFormat='⚠ {0}'}" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                                       Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="ProviderLine" Text="{Binding Provider}" Margin="0,1,0,0" FontSize="11" Foreground="{DynamicResource Overlay.Original}" Opacity="0.8"
                                       Visibility="{Binding DataContext.ProviderVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Control Style="{StaticResource ScrollRods}" Height="8" />
            </StackPanel>
        </DataTemplate>

        <!-- REQ-OUXC-44, REQ-HRD-8: a one-line ribbon per message (small seal, sender, translation); "…" while pending, "⚠" on failure.
             It unfurls and its seal stamps like the full dispatch (REQ-MOT-5). -->
        <DataTemplate x:Key="CompactItem">
            <Border x:Name="Card" Margin="0,0,0,3" Padding="6,3,10,3" Opacity="{Binding Opacity}" s:Motion.Entrance="Unfurl"
                    Background="{Binding DataContext.CardBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                    BorderBrush="{DynamicResource Livery.Primary}" BorderThickness="3,0,0,0">
                <DockPanel LastChildFill="True">
                    <ContentPresenter DockPanel.Dock="Right" ContentTemplate="{StaticResource CopyControls}" Content="{Binding}" />
                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource DispatchSeal}" Width="22" Height="22" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Top"
                                    s:Motion.Entrance="Stamp" s:Motion.Delay="0:0:0.3" />
                    <TextBlock x:Name="Line" TextWrapping="Wrap" FontSize="{Binding DataContext.CompactFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontFamily="{Binding DataContext.OverlayFontFamily, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Run Text="{Binding Channel, Mode=OneWay}" Foreground="{DynamicResource Overlay.Original}" />
                        <Run Text="{Binding SenderPrefix, Mode=OneWay}" Foreground="{DynamicResource Overlay.Sender}" FontWeight="SemiBold" />
                        <Run Text="{Binding Main, Mode=OneWay}" Foreground="{DynamicResource Overlay.Text}" />
                        <Run Text="{Binding PendingMark, Mode=OneWay}" Foreground="{DynamicResource Overlay.Original}" />
                        <Run Text="{Binding FailedMark, Mode=OneWay}" Foreground="{DynamicResource Danger}" FontWeight="Bold" />
                    </TextBlock>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Edit-mode chrome: visible only while positioning the overlay. -->
        <Border x:Name="EditFrame" Visibility="Collapsed" BorderBrush="{DynamicResource Ornament.Gold}" BorderThickness="1.5" CornerRadius="3">
            <Border Background="{DynamicResource Overlay.Bg}" Opacity="0.2" CornerRadius="3" />
        </Border>

        <StackPanel Margin="4">
            <Border x:Name="EditBar" Visibility="Collapsed" Background="{DynamicResource Accent.Gradient}" BorderBrush="{DynamicResource Ornament.Gold}" BorderThickness="0,2" Padding="10,5" Margin="0,0,0,6" Cursor="SizeAll"
                    MouseLeftButtonDown="OnDragStart">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Done" AutomationProperties.Name="Done" Style="{StaticResource Button.Ghost}" Foreground="{DynamicResource Text.OnAccent}" Click="OnDoneEditing" Padding="8,0" />
                    <TextBlock Text="Drag to move · edge to resize · ⧉ copies a message · Done to lock" Foreground="{DynamicResource Text.OnAccent}"
                               FontFamily="{StaticResource Font.Title}" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ItemTemplate is FullItem or CompactItem, set in ApplySettings from Overlay.Compact. -->
            <ItemsControl x:Name="Items" Focusable="False" ItemTemplate="{StaticResource FullItem}" />

            <Border x:Name="EmptyHint" Visibility="Collapsed" Padding="12,8" Background="{DynamicResource Overlay.Bg}" BorderBrush="{DynamicResource Or.Dark}" BorderThickness="1">
                <TextBlock Text="Translated chat will appear here." Foreground="{DynamicResource Overlay.Original}" FontFamily="{StaticResource Font.Aside}" FontStyle="Italic" FontSize="15" />
            </Border>
        </StackPanel>

        <Thumb x:Name="ResizeGrip" Visibility="Collapsed" Width="10" HorizontalAlignment="Right" Cursor="SizeWE" DragDelta="OnResize" Opacity="0.01" />
    </Grid>
</Window>

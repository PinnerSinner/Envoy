<Window x:Class="Envoy.App.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select chat area"
        WindowStyle="None" AllowsTransparency="True" Background="{DynamicResource Overlay.HitTest}"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross">
    <Grid>
        <!-- Dimmed screen with a hole where the selection is. -->
        <Path x:Name="Dim" Fill="{DynamicResource Overlay.Dim}">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullRect" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="HoleRect" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <Canvas x:Name="Surface">
            <Border x:Name="Selection" Visibility="Collapsed" BorderBrush="{DynamicResource Ornament.Gold}" BorderThickness="2">
                <Border BorderBrush="{DynamicResource Livery.Primary}" BorderThickness="1" Margin="2" />
            </Border>
            <Border x:Name="SizeTag" Visibility="Collapsed" Background="{DynamicResource Livery.Primary}" BorderBrush="{DynamicResource Ornament.Gold}" BorderThickness="1" Padding="8,2" CornerRadius="2">
                <TextBlock x:Name="SizeText" Foreground="{DynamicResource Text.OnAccent}" FontFamily="{StaticResource Font.Title}" FontSize="13" />
            </Border>
        </Canvas>

        <!-- Instructions: a vellum plate (spec 09a) -->
        <ContentControl Style="{StaticResource PlateFrame}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Padding="26,16" IsHitTestVisible="False">
            <StackPanel>
                <TextBlock x:Name="BannerTitle" Text="Mark the chat area" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock x:Name="BannerBody" Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="460">
                    Drag a box around where chat messages appear in the game. Include a little room for long messages.
                    <LineBreak />Press <Bold>Enter</Bold> to keep the current area, <Bold>Esc</Bold> to cancel.
                </TextBlock>
            </StackPanel>
        </ContentControl>
    </Grid>
</Window>

<Window x:Class="Envoy.App.Windows.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select chat area"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Cursor="Cross">
    <Grid>
        <!-- Dimmed screen with a hole where the selection is. -->
        <Path x:Name="Dim" Fill="#99000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullRect" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="HoleRect" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <Canvas x:Name="Surface">
            <Border x:Name="Selection" Visibility="Collapsed" BorderBrush="{DynamicResource Accent.Bright}" BorderThickness="2">
                <Border BorderBrush="{DynamicResource Accent.Dim}" BorderThickness="1" Margin="2" />
            </Border>
            <Border x:Name="SizeTag" Visibility="Collapsed" Background="{DynamicResource Accent}" Padding="6,2" CornerRadius="2">
                <TextBlock x:Name="SizeText" Foreground="{DynamicResource Text.OnAccent}" FontWeight="Bold" FontSize="11" />
            </Border>
        </Canvas>

        <!-- Instructions banner -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Padding="22,14" IsHitTestVisible="False"
                Background="{DynamicResource Bg.Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Mark the chat area" Style="{StaticResource Text.H2}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="460">
                    Drag a box around where chat messages appear in the game. Include a little room for long messages.
                    <LineBreak />Press <Bold>Enter</Bold> to keep the current area, <Bold>Esc</Bold> to cancel.
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>

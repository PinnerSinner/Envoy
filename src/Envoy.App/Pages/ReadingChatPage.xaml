<UserControl x:Class="Envoy.App.Pages.ReadingChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Envoy.App.Controls">
    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Reading Chat" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                Envoy looks at the chat area of your screen with the text recognition built into Windows. Nothing touches the game itself.
            </TextBlock>

            <!-- The page callout (spec 07a, REQ-OUXA-22). -->
            <ContentControl x:Name="PageCallout" Style="{StaticResource Callout}" Content="{Binding ReadingChatHint, Mode=OneWay}" />
            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Chat area" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Region" Style="{StaticResource Text.Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding RegionText, Mode=OneWay}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="Select chat area" Command="{Binding SelectRegionCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding RegionHint, Mode=OneWay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="220,0,0,6"
                               Visibility="{Binding HasRegionHint, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Game" Style="{StaticResource Text.Label}" />
                        <ComboBox AutomationProperties.Name="Game" Grid.Column="1" ItemsSource="{Binding Games}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Game}" />
                    </Grid>
                    <TextBlock Text="Each game remembers its own chat area, so switching between AoE II and AoE IV just works." Style="{StaticResource Text.Caption}" Margin="220,0,0,0" />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Languages to recognise" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10">
                        Windows needs the OCR pack for each script. Tick the ones your opponents use; your own language is always on.
                        Latin-script languages (Spanish, German, French…) are read by any Latin pack such as English.
                        Missing ones can be installed from Windows Settings → Time &amp; language → Language &amp; region, or with the Install button (asks for admin).
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding OcrLanguages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2,16,2">
                                    <Button DockPanel.Dock="Right" Content="Install" AutomationProperties.Name="{Binding Name, StringFormat='Install {0} text recognition'}" Padding="10,2" FontSize="11" Command="{Binding DataContext.InstallOcrCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Code}"
                                            Visibility="{Binding Installed, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding StatusText}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Text.Muted}" FontSize="11" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Fine tuning" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="Adapt reading speed to chat activity" IsChecked="{Binding Settings.Capture.AdaptivePolling}"
                              AutomationProperties.Name="Adapt reading speed to chat activity" />
                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding Settings.Capture.AdaptivePolling, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Fastest check (chat is moving)" Style="{StaticResource Text.Label}" />
                        <Slider Grid.Column="1" Minimum="150" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.MinIntervalMs}"
                                AutomationProperties.Name="Fastest check" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.MinIntervalMs, StringFormat='{}{0} ms'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding Settings.Capture.AdaptivePolling, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Slowest check (chat is quiet)" Style="{StaticResource Text.Label}" />
                        <Slider Grid.Column="1" Minimum="500" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.MaxIntervalMs}"
                                AutomationProperties.Name="Slowest check" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.MaxIntervalMs, StringFormat='{}{0} ms'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding Settings.Capture.AdaptivePolling, Converter={StaticResource InverseBoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Check for new messages every" Style="{StaticResource Text.Label}" />
                        <Slider AutomationProperties.Name="Check for new messages every" Grid.Column="1" Minimum="250" Maximum="3000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.IntervalMs}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.IntervalMs, StringFormat='{}{0} ms'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Enlarge before reading" Style="{StaticResource Text.Label}" />
                        <Slider AutomationProperties.Name="Enlarge before reading" Grid.Column="1" Minimum="1" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.Upscale}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.Upscale, StringFormat='{}{0:0.##}×'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Contrast" Style="{StaticResource Text.Label}" />
                        <Slider AutomationProperties.Name="Contrast" Grid.Column="1" Minimum="0.5" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Settings.Capture.Contrast}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Capture.Contrast, StringFormat='{}{0:0.0}'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <CheckBox Content="Greyscale" IsChecked="{Binding Settings.Capture.Grayscale}" />
                    <CheckBox Content="Invert colours (try this if light-on-dark text reads poorly)" IsChecked="{Binding Settings.Capture.Invert}" />
                    <CheckBox Content="Start reading chat when Envoy starts" IsChecked="{Binding Settings.StartCapturingAutomatically}" />
                    <CheckBox Content="Only read chat while an Age game is running (saves CPU)" IsChecked="{Binding Settings.Capture.OnlyWhileGameRuns}" />
                    <CheckBox Content="Pause while another window covers the chat area" IsChecked="{Binding Settings.Capture.PauseWhenCovered}"
                              AutomationProperties.Name="Pause while another window covers the chat area" />
                    <CheckBox Content="Pause when the game isn't the active window" IsChecked="{Binding Settings.Capture.PauseWhenNotForeground}"
                              AutomationProperties.Name="Pause when the game isn't the active window" />
                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding HasCaptureBackendChoice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Capture method" Style="{StaticResource Text.Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CaptureBackends}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Capture.Backend}" AutomationProperties.Name="Capture method" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Understanding chat" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8">
                        How Envoy turns what it reads into messages. Game notices are never translated.
                    </TextBlock>
                    <CheckBox Content="Join messages that wrap onto the next line" IsChecked="{Binding Settings.Chat.StitchWrappedLines}"
                              AutomationProperties.Name="Join messages that wrap onto the next line" />
                    <CheckBox Content="Hide game notices (lines that aren't a player talking)" IsChecked="{Binding Settings.Chat.HideSystemLines}"
                              AutomationProperties.Name="Hide game notices (lines that aren't a player talking)" />
                    <CheckBox Content="Treat lines that start with a player's name but have no ':' as notices" IsChecked="{Binding Settings.Chat.DetectSystemLinesByPlayerName}"
                              AutomationProperties.Name="Treat lines that start with a player's name but have no ':' as notices" />
                    <CheckBox Content="Remove stray symbols that OCR reads from icons" IsChecked="{Binding Settings.Chat.CleanSymbols}"
                              AutomationProperties.Name="Remove stray symbols that OCR reads from icons" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Chat format" Style="{StaticResource Text.Label}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ChatFormatOptions, Mode=OneWay}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Chat.FormatProfile}" AutomationProperties.Name="Chat format" />
                    </Grid>
                    <TextBlock Text="Also treat these lines as notices" Style="{StaticResource Text.Label}" Margin="0,8,0,4" />
                    <TextBox x:Name="SystemLinePatternsBox" Text="{Binding SystemLinePatternsText, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="64"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="Also treat these lines as notices" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0">
                        One per line. * matches anything, {player} matches a name, and starting a line with re: makes it a regular expression.
                    </TextBlock>
                    <TextBlock x:Name="ChatUnderstandingErrors" Text="{Binding ChatUnderstandingStatus, Mode=OneWay}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasChatUnderstandingErrors, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="PreviewStats" Text="{Binding CapturePreview.Stats}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="Live view" Style="{StaticResource Text.H2}" />
                    </DockPanel>
                    <TextBlock x:Name="PreviewHealth" Text="{Binding CapturePreview.HealthText, Mode=OneWay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewMetrics" Text="{Binding CapturePreview.MetricsText, Mode=OneWay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="What Envoy sees (after enhancement) and what it read. Open a game with chat on screen to tune the settings above." Style="{StaticResource Text.Caption}" Margin="0,0,0,8" />
                    <Border BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" Background="{DynamicResource Bg.Input}" MinHeight="80">
                        <Image x:Name="PreviewImage" Source="{Binding CapturePreview.Image}" Stretch="Uniform" MaxHeight="240" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBox x:Name="PreviewText" AutomationProperties.Name="Text Envoy read" c:AutoApply.Ignore="True" Text="{Binding CapturePreview.Text, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" Margin="0,8,0,0" VerticalContentAlignment="Top" />
                    <TextBlock x:Name="PreviewUnderstood" Text="{Binding CapturePreview.UnderstoodText, Mode=OneWay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding CapturePreview.CanCopy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <Button x:Name="CopyTestCapture" Content="Copy as test capture" Command="{Binding CapturePreview.CopyAsTestCaptureCommand}"
                                AutomationProperties.Name="Copy as test capture" DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding CapturePreview.CopyCaption, Mode=OneWay}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </DockPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Envoy.App.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Appearance" Style="{StaticResource Text.H1}" />
            <TextBlock Text="Each theme takes its cue from one of the games. Settings, the overlay and the reply box all follow it." Style="{StaticResource Text.Body}" Margin="0,0,0,18" />
            <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ThemeCard}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="250">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Swatches}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="40" Height="26" Fill="{Binding}" Margin="0,0,4,0" Stroke="#40000000" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Display}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Accent.Bright}" />
                                <TextBlock Text="{Binding Inspiration}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Startup & updates stays the last group (contract §8.6: Theme → Accessibility → Notifications → Startup & updates). -->
            <ContentControl Style="{StaticResource OrnateFrame}" Margin="0,10,0,14">
                <StackPanel>
                    <TextBlock Text="Startup &amp; updates" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="Start Envoy when I sign in to Windows" IsChecked="{Binding Settings.StartWithWindows}"
                              AutomationProperties.Name="Start Envoy when I sign in to Windows" />
                    <CheckBox Content="Check for updates automatically" IsChecked="{Binding Settings.CheckForUpdates}"
                              AutomationProperties.Name="Check for updates automatically" />
                    <TextBlock Text="Checks go to GitHub only. Off means Envoy makes no update request unless you press Check for updates on About."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="26,0,0,6" />
                    <CheckBox Content="Download updates in the background (never during a game)" IsChecked="{Binding Settings.Updates.AutoDownload}"
                              IsEnabled="{Binding IsInstalled, Mode=OneWay}" ToolTipService.ShowOnDisabled="True"
                              AutomationProperties.Name="Download updates in the background" ToolTip="{Binding AutoDownloadTooltip, Mode=OneWay}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Update channel" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                            <TextBlock Text="Switching back to Stable keeps your current build until a newer stable release comes out."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding UpdateChannels}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Settings.Updates.Channel}" AutomationProperties.Name="Update channel" />
                    </Grid>

                    <TextBlock Text="Data" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Open logs" Command="{Binding OpenLogsCommand}" Padding="10,3" AutomationProperties.Name="Open logs" />
                        <CheckBox Content="Save chat transcripts on this PC (one file per match)" IsChecked="{Binding Settings.SaveTranscripts}" />
                    </DockPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

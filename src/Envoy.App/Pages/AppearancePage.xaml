<UserControl x:Class="Envoy.App.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:Envoy.Core.Ux;assembly=Envoy.Core">
    <ScrollViewer Padding="0,0,10,0" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Livery" Style="{StaticResource Text.H2}" />
            <TextBlock Text="Each livery takes its colours from one of the games. Settings, the overlay and the reply box all follow it." Style="{StaticResource Text.Body}" Margin="0,0,0,14" />
            <ItemsControl x:Name="ThemesList" ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource ThemeCard}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding Inspiration}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Width="196">
                            <StackPanel>
                                <Path Data="{StaticResource Geo.Shield}" Stretch="Uniform" Height="72" HorizontalAlignment="Center" Margin="0,4,0,10"
                                      Fill="{Binding Field}" Stroke="{DynamicResource Or.Dark}" StrokeThickness="2.5" />
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Font.Title}" FontSize="18" Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Inspiration}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Accessibility (spec 07b): the high-contrast palette, between Theme and Notifications (contract §8.6). -->
            <ContentControl x:Name="AccessibilityFrame" Style="{StaticResource OrnateFrame}" Margin="0,10,0,14">
                <StackPanel>
                    <TextBlock Text="Accessibility" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource RowLabel}" Content="High contrast" />
                        <ComboBox x:Name="HighContrastBox" Grid.Column="1" Width="260" HorizontalAlignment="Left" ItemsSource="{Binding HighContrastModes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Accessibility.HighContrast}"
                                  AutomationProperties.Name="High contrast"
                                  AutomationProperties.HelpText="Use Windows' contrast theme colours instead of the game theme." />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="260,0,0,6"
                               Text="Follow Windows uses your contrast theme's colours whenever a Windows contrast theme is on." />
                    <TextBlock x:Name="HighContrastStatusText" Text="{Binding HighContrastStatus, Mode=OneWay}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="260,0,0,0" />

                    <!-- Motion (spec 09b, REQ-MOT-1): how much the app animates. -->
                    <Grid Style="{StaticResource SettingRow}" Margin="0,10,0,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource RowLabel}" Content="Motion" />
                        <ComboBox x:Name="MotionBox" Grid.Column="1" Width="260" HorizontalAlignment="Left" ItemsSource="{Binding MotionModes}"
                                  DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Appearance.Motion}"
                                  AutomationProperties.Name="Motion"
                                  AutomationProperties.HelpText="How much Envoy animates: follow Windows, full, fades only or off." />
                    </Grid>
                    <TextBlock Text="{x:Static ux:MotionText.Help}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="260,0,0,0" />
                </StackPanel>
            </ContentControl>

            <!-- Notifications (spec 07a): advisory tray balloons. Off keeps the War Room list (contract §2.2). -->
            <ContentControl x:Name="NotificationsFrame" Style="{StaticResource OrnateFrame}" Margin="0,10,0,14">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="Show tips in the notification area" IsChecked="{Binding Settings.Notifications.Enabled}"
                              AutomationProperties.Name="Show tips in the notification area" />
                    <TextBlock Text="Tips wait while the game is in front and never take focus. The War Room lists them either way."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="26,0,0,6" />
                    <StackPanel Margin="26,0,0,0" IsEnabled="{Binding Settings.Notifications.Enabled}">
                        <CheckBox Content="A text recognition pack is missing" IsChecked="{Binding Settings.Notifications.OcrLanguageMissing}"
                                  AutomationProperties.Name="Tip when a text recognition pack is missing" />
                        <CheckBox Content="A translation provider keeps failing" IsChecked="{Binding Settings.Notifications.ProviderFailing}"
                                  AutomationProperties.Name="Tip when a translation provider keeps failing" />
                        <CheckBox Content="An Envoy update is available" IsChecked="{Binding Settings.Notifications.UpdateAvailable}"
                                  AutomationProperties.Name="Tip when an Envoy update is available" />
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- Startup & updates stays the last group (contract §8.6: Theme → Accessibility → Notifications → Startup & updates). -->
            <ContentControl x:Name="StartupFrame" Style="{StaticResource OrnateFrame}" Margin="0,10,0,14">
                <StackPanel>
                    <TextBlock Text="Startup &amp; updates" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="Start Envoy when I sign in to Windows" IsChecked="{Binding Settings.StartWithWindows}"
                              AutomationProperties.Name="Start Envoy when I sign in to Windows" />
                    <CheckBox Content="Check for updates automatically" IsChecked="{Binding Settings.CheckForUpdates}"
                              AutomationProperties.Name="Check for updates automatically" />
                    <TextBlock Text="Checks go to GitHub only. Off means Envoy makes no update request unless you press Check for updates on About."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="26,0,0,6" />
                    <CheckBox Content="Download updates in the background (never during a game)" IsChecked="{Binding Settings.Updates.AutoDownload}"
                              IsEnabled="{Binding IsInstalled, Mode=OneWay}" ToolTipService.ShowOnDisabled="True"
                              AutomationProperties.Name="Download updates in the background" ToolTip="{Binding AutoDownloadTooltip, Mode=OneWay}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Update channel" Style="{StaticResource Text.Label}" FontWeight="SemiBold" />
                            <TextBlock Text="Switching back to Stable keeps your current build until a newer stable release comes out."
                                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="260" ItemsSource="{Binding UpdateChannels}" DisplayMemberPath="Label"
                                  SelectedValuePath="Value" SelectedValue="{Binding Settings.Updates.Channel}" AutomationProperties.Name="Update channel" />
                    </Grid>

                    <TextBlock Text="Data" Style="{StaticResource Text.Label}" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Open logs" Command="{Binding OpenLogsCommand}" Padding="10,3" AutomationProperties.Name="Open logs" />
                        <CheckBox Content="Save chat transcripts on this PC (one file per match)" IsChecked="{Binding Settings.SaveTranscripts}" />
                    </DockPanel>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="Envoy.App.Pages.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Envoy.App.Controls">
    <ScrollViewer Padding="32,24">
        <StackPanel MaxWidth="900">
            <TextBlock Text="Translation" Style="{StaticResource Text.H1}" />
            <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,18">
                The free providers need no account. Paid ones use <Bold>your own</Bold> key and are billed to you directly.
                Envoy has no server of its own, so nobody else can ever spend your credits.
            </TextBlock>

            <!-- The page callout (spec 07a, REQ-OUXA-22). -->
            <ContentControl x:Name="PageCallout" Style="{StaticResource Callout}" Content="{Binding TranslationHint, Mode=OneWay}" />
            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Providers" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Main provider" Style="{StaticResource Text.Label}" />
                        <ComboBox AutomationProperties.Name="Main provider" AutomationProperties.HelpText="{Binding PrimaryInfo.Blurb, Mode=OneWay}" Grid.Column="1" ItemsSource="{Binding Providers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding PrimaryProvider}" />
                    </Grid>
                    <TextBlock Text="{Binding PrimaryInfo.Blurb}" Style="{StaticResource Text.Caption}" Margin="220,0,0,8" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="If it fails, try" Style="{StaticResource Text.Label}" />
                        <ComboBox AutomationProperties.Name="If it fails, try" Grid.Column="1" ItemsSource="{Binding FallbackOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FallbackProvider}" />
                    </Grid>
                    <TextBlock Text="{Binding Host.ProviderStatus}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Accent}" Margin="220,4,0,0" />
                </StackPanel>
            </ContentControl>

            <!-- Provider health (spec 03, REQ-TRR-18): one row per provider in the active chain. -->
            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Provider health" Style="{StaticResource Text.H2}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Envoy tries these in order. A provider that keeps failing is skipped for a while, then tried again with the next message." />
                    <ItemsControl x:Name="HealthList" ItemsSource="{Binding ProviderHealthRows}" Focusable="False" AutomationProperties.Name="Provider health">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="196" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Decorative: the state is in the row text. -->
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Text.Muted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Healthy">
                                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Degraded">
                                                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Throttled">
                                                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="CoolingDown">
                                                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="AuthFailed">
                                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="QuotaExceeded">
                                                        <Setter Property="Fill" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}">
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Label}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LastSuccessText}" Style="{StaticResource Text.Caption}" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Retry now" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RetryProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding ProviderId}"
                                            AutomationProperties.Name="{Binding RetryName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Credentials: only the ones in use are shown -->
            <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsDeepL, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="DeepL" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="API key" Style="{StaticResource Text.Label}" />
                        <PasswordBox AutomationProperties.Name="API key" Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.DeepLKey}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,0">
                        Free plan: 500,000 characters a month. <Hyperlink NavigateUri="https://www.deepl.com/pro-api" Command="{Binding OpenLinkCommand}" CommandParameter="https://www.deepl.com/pro-api">Get a key</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsClaude, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Claude" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Anthropic API key" Style="{StaticResource Text.Label}" />
                        <PasswordBox AutomationProperties.Name="Anthropic API key" Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.ClaudeKey}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Model" Style="{StaticResource Text.Label}" />
                        <ComboBox AutomationProperties.Name="Model" Grid.Column="1" ItemsSource="{Binding ClaudeModels}" IsEditable="False" SelectedItem="{Binding Settings.Translation.ClaudeModel}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,0" TextWrapping="Wrap">
                        Haiku costs a fraction of a cent per message and is plenty for chat; Opus is the most capable.
                        <Hyperlink NavigateUri="https://console.anthropic.com/" Command="{Binding OpenLinkCommand}" CommandParameter="https://console.anthropic.com/">Get a key</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsAws, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Amazon Translate" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Access key ID" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="Access key ID" Grid.Column="1" Text="{Binding Settings.Translation.AwsAccessKeyId, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Secret access key" Style="{StaticResource Text.Label}" />
                        <PasswordBox AutomationProperties.Name="Secret access key" Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.AwsSecretAccessKey}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Region" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="Region" Grid.Column="1" Width="200" HorizontalAlignment="Left" Text="{Binding Settings.Translation.AwsRegion, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="220,0,0,0" TextWrapping="Wrap">
                        Use an IAM user that can only call translate:TranslateText, and set a billing alarm in AWS for peace of mind.
                    </TextBlock>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}" Visibility="{Binding NeedsLibre, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="LibreTranslate" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Server URL" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="Server URL" Grid.Column="1" Text="{Binding Settings.Translation.LibreTranslateUrl, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="API key (if required)" Style="{StaticResource Text.Label}" />
                        <PasswordBox AutomationProperties.Name="API key (if required)" Grid.Column="1" c:SecretBox.Value="{Binding Settings.Translation.LibreTranslateKey}" />
                    </Grid>
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Behaviour" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="Don't translate messages already in my language" IsChecked="{Binding Settings.Translation.SkipMyLanguage}" />
                    <CheckBox Content="Explain gamer slang (666, ㅈㅈ, изи, kkkk…) instantly and offline" IsChecked="{Binding Settings.Translation.UseSlangGlossary}" />
                    <Grid Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Daily cap for paid providers" Style="{StaticResource Text.Label}" />
                        <Slider AutomationProperties.Name="Daily cap for paid providers" AutomationProperties.HelpText="When the cap is reached Envoy switches to the free provider until tomorrow. 0 means no cap." Grid.Column="1" Minimum="0" Maximum="500000" SmallChange="5000" LargeChange="25000" TickFrequency="5000" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Translation.DailyCharacterLimit}" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Translation.DailyCharacterLimit, StringFormat='{}{0:N0} chars'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="A busy match is roughly 2,000 to 5,000 characters. When the cap is reached Envoy switches to the free provider until tomorrow. 0 = no cap." Margin="220,0,0,0" />
                    <Grid Style="{StaticResource SettingRow}" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Give up after" Style="{StaticResource Text.Label}" />
                        <Slider Grid.Column="1" Minimum="5" Maximum="30" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Settings.Translation.RequestTimeoutSeconds}" AutomationProperties.Name="Give up on a chat line after this many seconds" />
                        <TextBlock Grid.Column="2" Text="{Binding Settings.Translation.RequestTimeoutSeconds, StringFormat='{}{0} s'}" Style="{StaticResource Text.Label}" Margin="12,0,0,0" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="220,0,0,0"
                               Text="How long Envoy keeps trying a chat line, including retries and your fallback provider, before showing it as failed." />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Saved translations" Style="{StaticResource Text.H2}" />
                    <CheckBox Content="Remember translations between sessions" IsChecked="{Binding Settings.Translation.RememberTranslations}"
                              AutomationProperties.Name="Remember translations between sessions" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Repeated lines like &quot;gg wp&quot; are then translated instantly, and for free with a paid provider. The file holds translations of chat lines you received, in your language, plus a one-way fingerprint of each original line. It never leaves this PC." />
                    <TextBlock Text="{Binding CacheCountText}" Style="{StaticResource Text.Label}" Margin="0,8,0,0" />
                    <Button Content="Clear saved translations" Command="{Binding ClearTranslationCacheCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            AutomationProperties.Name="Clear saved translations" />
                    <TextBlock Text="{Binding CacheStatus}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Filters" Style="{StaticResource Text.H2}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Translate" Style="{StaticResource Text.Label}" />
                        <ComboBox AutomationProperties.Name="Translate" Grid.Column="1" ItemsSource="{Binding ChannelOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Channels}" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Muted players" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="Muted players" Grid.Column="1" Text="{Binding MutedPlayersText, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <TextBlock Text="Comma-separated names. Their messages are hidden and never sent for translation." Style="{StaticResource Text.Caption}" Margin="220,0,0,0" />
                </StackPanel>
            </ContentControl>

            <ContentControl Style="{StaticResource OrnateFrame}">
                <StackPanel>
                    <TextBlock Text="Try it" Style="{StaticResource Text.H2}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Translate" Command="{Binding TestTranslateCommand}" Margin="8,0,0,0" />
                        <TextBox x:Name="TestInput" AutomationProperties.Name="Text to translate" c:AutoApply.Ignore="True" Text="{Binding TranslationTestInput, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock x:Name="TestOutput" Text="{Binding TranslationTestOutput}" Style="{StaticResource Text.Label}" Margin="0,10,0,0" FontSize="15" />
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>

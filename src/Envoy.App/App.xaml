<Application x:Class="Envoy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0 is the palette; ThemeManager swaps it at runtime. -->
                <ResourceDictionary Source="pack://application:,,,/Envoy;component/Themes/Palette.imperial.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Envoy;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

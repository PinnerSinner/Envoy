<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Nullable warnings are errors in every build, local or CI (REQ-QSC-2). -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.55.0" />
    <PackageReference Include="AWSSDK.Translate" Version="4.0.101.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Phrases\phrases.json" LogicalName="Envoy.Core.Phrases.phrases.json" />
    <InternalsVisibleTo Include="Envoy.Core.Tests" />
  </ItemGroup>
</Project>
